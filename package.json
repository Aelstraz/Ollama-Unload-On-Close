{
  "name": "ollama-unload-on-close",
  "displayName": "Ollama Unload On Close",
  "description": "Automatically stops/unloads any loaded models when vscode is closed",
  "version": "0.0.2",
  "publisher": "Aelstraz",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": "https://github.com/aelstraz/ollama-unload-on-close.git",
  "contributes": {
    "commands": [
      {
        "command": "ollama-unload-on-close.unload-models",
        "title": "Ollama Unload On Close: Unload Models"
      }
    ],
    "configuration": {
      "properties": {
        "ollamaUnloadOnClose.onlyCloseSessionModels": {
          "type": "boolean",
          "default": true,
          "description": "Will only unload models that have been loaded during this session"
        },
        "ollamaUnloadOnClose.ignoreModels": {
          "type": "array",
          "default": [],
          "description": "Will not unload any model in this list",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}